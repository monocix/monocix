{
	"name": "monocix",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@12.11.2",
	"scripts": {
		"dev": "pnpm -r dev",
		"test": "pnpm -r test",
		"test:app": "pnpm --filter monocix-app test",
		"test:api": "pnpm --filter monocix-api test",
		"db:up": "docker compose up -d",
		"db:down": "docker compose down",
		"db:reset": "docker compose down -v && docker compose up -d"
	}
}
